# Database Configuration
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/govt_scheme_db
SQLALCHEMY_ECHO=False
SQLALCHEMY_POOL_SIZE=20
SQLALCHEMY_POOL_RECYCLE=3600

# Environment
ENVIRONMENT=development
DEBUG=True

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=True
LOG_LEVEL=INFO

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080", "http://10.80.26.147:8000"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Password Policy
MIN_PASSWORD_LENGTH=8
REQUIRE_UPPERCASE=True
REQUIRE_LOWERCASE=True
REQUIRE_DIGITS=True
REQUIRE_SPECIAL_CHARS=True

# Email Validation
ALLOWED_EMAIL_DOMAINS=["*"]

# Logging
LOG_DIR=logs
LOG_FILE=app.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# File Upload (Future Module 7)
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=uploads

# API Documentation
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

# Feature Flags
ENABLE_AADHAAR_VALIDATION=True
ENABLE_RATION_CARD_VALIDATION=True
ENABLE_AUDIT_LOGGING=True
